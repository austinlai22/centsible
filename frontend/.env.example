# The base URL of your deployed backend API.
# Local development (matches server/.env.example's default PORT):
VITE_API_URL=http://localhost:3001

# Production: set this to your real deployed backend URL, e.g.
# VITE_API_URL=https://api.flowapp.com
#
# This must be a value Vite can see AT BUILD TIME — Vite inlines
# import.meta.env.VITE_* variables into the built JS during `npm run build`.
# Changing this after building requires rebuilding, not just restarting
# the server. If you deploy frontend and backend separately (e.g. Vercel +
# Railway), set this in your hosting platform's build-time environment
# variables, not just a local .env file.
