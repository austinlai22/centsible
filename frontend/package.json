    "test:onboarding": "node scripts/test-onboarding.mjs",
    "preflight": "bash ../scripts/preflight.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "playwright": "^1.62.1",
    "vite": "^5.4.1"
  }
}
