{
  "name": "centsible-server",
  "version": "1.0.0",
  "description": "Centsible backend — Express + PostgreSQL",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "test:identities": "node scripts/test-identities.mjs",
    "test:totp": "node scripts/test-totp.mjs",
    "test:mfa": "bash scripts/test-mfa.sh",
    "test:api": "bash scripts/test-api.sh",
    "test:calendar": "bash scripts/test-calendar.sh",
    "start:prod": "node db/migrate.js && node --import ./instrument.js index.js"
  },
  "dependencies": {
    "@sentry/node": "^10.72.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "plaid": "^26.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
