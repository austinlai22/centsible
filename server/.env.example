# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────────────
# Full Postgres connection string.
# Running locally without Docker: use localhost as shown below.
# Running via docker-compose: docker-compose.yml overrides this automatically
# to point at the "db" service by its Docker network name — you don't need
# to change this value for Docker, but it must still be present and valid
# for local (non-Docker) use.
DATABASE_URL=postgresql://flow_user:yourpassword@localhost:5432/flow_db

# These three are read directly by docker-compose.yml when building the
# Postgres container. Keep them in sync with the credentials in DATABASE_URL
# above if you're running locally without Docker too.
POSTGRES_USER=flow_user
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=flow_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING

# Access tokens expire in 15 minutes; refresh tokens in 7 days
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Encryption ────────────────────────────────────────────────────────────────
# AES-256 requires exactly 32 bytes (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_STRING

# ─── Plaid ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Public URL Plaid will POST webhook events to (new transactions, item errors).
# Must be reachable from the internet — Plaid cannot reach localhost.
# Local development: use ngrok (`ngrok http 3001`) and paste the forwarding
# URL here, e.g. https://abcd1234.ngrok-free.app/plaid/webhook
# Production: your real public API URL, e.g. https://api.flowapp.com/plaid/webhook
PLAID_WEBHOOK_URL=https://your-domain.com/plaid/webhook

# ─── CORS ──────────────────────────────────────────────────────────────────────
# The URL your React frontend is served from
CLIENT_ORIGIN=http://localhost:5173
