# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ──────────────────────────────────────────────────────────────────
# Full Postgres connection string.
# Running locally without Docker: use localhost as shown below.
# Running via docker-compose: docker-compose.yml overrides this automatically
# to point at the "db" service by its Docker network name — you don't need
# to change this value for Docker, but it must still be present and valid
# for local (non-Docker) use.
DATABASE_URL=postgresql://flow_user:yourpassword@localhost:5432/flow_db

# These three are read directly by docker-compose.yml when building the
# Postgres container. Keep them in sync with the credentials in DATABASE_URL
# above if you're running locally without Docker too.
POSTGRES_USER=flow_user
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=flow_db

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_HEX_STRING

# Access tokens expire in 15 minutes; refresh tokens in 7 days
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Encryption ────────────────────────────────────────────────────────────────
# AES-256 requires exactly 32 bytes (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_STRING

# ─── Plaid ─────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox

# Public URL Plaid will POST webhook events to (new transactions, item errors).
# Must be reachable from the internet — Plaid cannot reach localhost.
# Local development: use ngrok (`ngrok http 3001`) and paste the forwarding
# URL here, e.g. https://abcd1234.ngrok-free.app/plaid/webhook
# Production: your real public API URL, e.g. https://api.flowapp.com/plaid/webhook
PLAID_WEBHOOK_URL=https://your-domain.com/plaid/webhook

# ─── CORS ──────────────────────────────────────────────────────────────────────
# The URL your React frontend is served from
CLIENT_ORIGIN=http://localhost:5173

# ─── Deployment tuning (all optional — sensible defaults if unset) ─────────────

# Number of reverse-proxy hops in front of this server, passed to Express's
# "trust proxy". Railway / Render / Fly / a single nginx or Caddy = 1.
# Getting this wrong breaks rate limiting: with it unset behind a proxy, every
# request appears to come from the proxy's IP, so all users share one bucket
# and the 10-per-15-min auth limiter locks out the whole app. Never set this
# higher than the real hop count — each extra hop is one more X-Forwarded-For
# entry a client could forge to evade the limiter.
TRUST_PROXY_HOPS=1

# Global rate limit: requests per IP per 15 minutes. A single page load costs
# ~7 requests, so keep meaningful headroom.
RATE_LIMIT_MAX=600

# Rate limit for /auth/login and /auth/register specifically, per IP per 15
# minutes. This is the brute-force defence on password login — raise it only
# for automated test runs, never to quiet real users.
AUTH_RATE_LIMIT_MAX=10

# Rate limit for /auth/mfa/* per IP per 15 minutes. Guards code-guessing across
# many accounts from one source; a single targeted account is separately
# protected by a 5-failure lockout on the factor itself (lib/mfa.js).
MFA_RATE_LIMIT_MAX=20

# Set to "false" ONLY if your managed Postgres presents a cert Node can't
# validate (Supabase's pooler, Heroku, some Render/Fly setups) and you cannot
# supply its CA. Prefer providing the CA via PGSSLROOTCERT instead — turning
# this off disables certificate verification on the database connection.
# PGSSL_REJECT_UNAUTHORIZED=false

# SameSite policy for the auth cookies. Defaults to "none" in production
# (required when the frontend and API are on different domains, e.g. Vercel +
# Railway) and "lax" in development. Set to "strict" only if the frontend and
# API are served from the exact same origin.
# COOKIE_SAME_SITE=strict
